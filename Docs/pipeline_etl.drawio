        <mxCell id="lane_bi" value="CONSUMO" style="swimlane;html=1;startSize=30;horizontal=1;fontSize=13;fontStyle=1;fillColor=#FFF8E1;strokeColor=#F2C811;fontColor=#7A6000;swimlaneFillColor=#FFFDF5;" vertex="1" parent="1">
          <mxGeometry x="1260" y="520" width="300" height="230" as="geometry" />
        </mxCell>
        <mxCell id="bi_conn" value="Conector nativo PostgreSQL&#10;modo Importar · localhost:5432" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2C811;strokeColor=none;fontColor=#3B3B3B;fontSize=11;fontStyle=1;" vertex="1" parent="lane_bi">
          <mxGeometry x="25" y="40" width="250" height="45" as="geometry" />
        </mxCell>
        <mxCell id="bi_pq" value="Power Query: filtro travel_date &lt; 2022-01-01&#10;(excluye año parcial) → 75.000 filas" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F2C811;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="lane_bi">
          <mxGeometry x="25" y="100" width="250" height="45" as="geometry" />
        </mxCell>
        <mxCell id="bi_dash" value="Tablero: 5 preguntas · KPI · tendencia&#10;ranking · distribución · segmentadores" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFECB3;strokeColor=#F2C811;fontSize=10;align=left;spacingLeft=10;fontStyle=1;" vertex="1" parent="lane_bi">
          <mxGeometry x="25" y="160" width="250" height="45" as="geometry" />
